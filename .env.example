# Grimoire engine environment
# Copy to .env and adjust for your setup

# ── KB directory (required) ───────────────────────────────────────────────────────
# Path to the grimoire-kb directory (the knowledge base)
GRIMOIRE_ROOT=~/data/grimoire-kb

# ── Remote mode (run from another host, requires grim serve on the KB host) ───────
# Set to the grimoire server URL if running on a different machine
# GRIMOIRE_HOST=http://aid:3663

# ── AI ───────────────────────────────────────────────────────────────────────────
# Ollama base URL (default: http://localhost:11434)
# Change to your local AI host if running elsewhere
OLLAMA_HOST=http://localhost:11434

# ── Server ───────────────────────────────────────────────────────────────────────
# Port for grim-server (default: 3663)
GRIMOIRE_PORT=3663
