#!/usr/bin/env bash
# .githooks/pre-commit — block hardcoded bare-hostname URLs in source files
#
# A "bare hostname" is a single-label name with a port (e.g. http://aid:3663).
# These must live in ~/.config/lbl-config.json and be resolved via lblEndpoint()
# or the equivalent bash snippet — never hardcoded in source.
#
# Skips: comment-only lines, lbl-config.json, .md files, this hooks dir
# Allows: localhost, 127.x.x.x
#
# Activate (once per clone):
#   git config core.hooksPath .githooks

set -euo pipefail

EXTS='\.(js|ts|sh|bash)$'
SKIP='^(.*lbl-config\.json|\.githooks/.*|.*\.md|.*\.env\.example|deploy/.*)$'

# bare hostname URL: starts with a letter, no dots before the colon, has port
PATTERN='https?://[a-zA-Z][a-zA-Z0-9-]+:[0-9]'
ALLOWED_RE='(localhost|127[.][0-9])'

errors=0

while IFS= read -r file; do
  [[ "$file" =~ $EXTS ]] || continue
  [[ "$file" =~ $SKIP ]] && continue

  # Use awk on staged content:
  #   skip blank lines and comment-only lines (# // * style)
  #   flag lines matching bare-hostname URL pattern that aren't localhost/127.x
  hits=$(git show ":$file" 2>/dev/null | awk -v pat="$PATTERN" -v allow="$ALLOWED_RE" '
    /^[[:space:]]*(\/\/|#|\*|\/\*)/ { next }
    /nohost/ { next }
    $0 ~ pat {
      if ($0 !~ allow) { print NR": "$0 }
    }
  ' || true)

  if [[ -n "$hits" ]]; then
    echo ""
    echo "  BLOCKED  $file — hardcoded hostname URL(s):"
    echo "$hits" | while IFS= read -r hit; do
      echo "    $hit"
    done
    errors=$((errors + 1))
  fi
done < <(git diff --cached --name-only)

if [[ $errors -gt 0 ]]; then
  echo ""
  echo "  No bare hostnames in source. Use lblEndpoint() / lbl-config.json instead."
  echo "  Bypass (docs/infra only): git commit --no-verify"
  echo ""
  exit 1
fi

# ── config/lbl-config.json validity ───────────────────────────────────────────
# Canonical config authority — must parse and have top-level endpoints/use objects.

if git diff --cached --name-only | grep -qx 'config/lbl-config.json'; then
  if ! node -e "
    const c = JSON.parse(require('fs').readFileSync(0, 'utf8'));
    if (!c.endpoints || !c.use) { console.error('missing top-level endpoints or use object'); process.exit(1) }
  " < <(git show ':config/lbl-config.json'); then
    echo ""
    echo "  BLOCKED  config/lbl-config.json — invalid (must parse, must have 'endpoints' and 'use')"
    echo ""
    exit 1
  fi

  # Change visibility — post a one-line noise-floor thought. Best-effort:
  # a down/unreachable server must never block the commit.
  GRIMOIRE_HOST="${GRIMOIRE_HOST:-$(node -e "
    const fs=require('fs'),os=require('os'),p=require('path');
    try {
      const c=JSON.parse(fs.readFileSync(p.join(os.homedir(),'.config','lbl-config.json'),'utf8'));
      process.stdout.write(c.endpoints?.grimoire||'http://aid:3663');
    } catch { process.stdout.write('http://aid:3663'); }
  " 2>/dev/null || echo 'http://aid:3663')}"

  before_json="$(git show 'HEAD:config/lbl-config.json' 2>/dev/null || echo '{}')"
  after_json="$(git show ':config/lbl-config.json')"

  changed_keys="$(node -e "
    let before = {}, after = {};
    try { before = JSON.parse(process.argv[1]) } catch {}
    try { after  = JSON.parse(process.argv[2]) } catch {}
    const keys = new Set([...Object.keys(before), ...Object.keys(after)]);
    const changed = [];
    for (const k of keys) {
      if (JSON.stringify(before[k]) !== JSON.stringify(after[k])) changed.push(k);
    }
    process.stdout.write(changed.join(', ') || 'none');
  " "$before_json" "$after_json" 2>/dev/null || echo 'unknown')"

  curl -s --max-time 2 -X POST "${GRIMOIRE_HOST}/noise-floor/think" \
    -H 'Content-Type: application/json' \
    -d "{\"text\":\"config/lbl-config.json changed: ${changed_keys}\",\"type\":\"observation\",\"source\":\"pre-commit\"}" \
    >/dev/null 2>&1 || true
fi

exit 0
