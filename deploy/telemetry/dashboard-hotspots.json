      "type": "stat",
      "targets": [
        {
          "expr": "gen_model_loaded{job!=\"grafana\"} == 1",
          "legendFormat": "{{box}}/{{service}}/{{model}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["count"],
          "fields": ""
        },
        "orientation": "auto"
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 8 }
            ]
          },
          "custom": {
            "axisCenteredZero": false,
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 80,
            "gradientMode": "none",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "stack" },
            "thresholdsStyle": { "mode": "off" }
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "Queue / Running",
      "type": "timeseries",
      "targets": [
        {
          "expr": "gen_queue_pending{job!=\"grafana\"}",
          "legendFormat": "{{box}}/{{service}} queue",
          "refId": "A"
        },
        {
          "expr": "gen_requests_running{job!=\"grafana\"}",
          "legendFormat": "{{box}}/{{service}} running",
          "refId": "B"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": [] }
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 90,
                "to": 100,
                "result": { "text": "ALERT", "color": "dark-red" }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 89.99,
                "result": { "text": "OK", "color": "green" }
              }
            }
          ],
          "custom": {
            "filterable": false
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "VRAM > 90% Alert",
      "type": "state-color",
      "targets": [
        {
          "expr": "gen_gpu_vram_used_mb{job!=\"grafana\"} / gen_gpu_vram_total_mb{job!=\"grafana\"} > 0.9",
          "legendFormat": "{{box}}/{{service}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "showHeader": true
      }
    }
