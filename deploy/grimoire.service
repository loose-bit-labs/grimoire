# Grimoire Knowledge Graph Server — user-space unit (house convention, phase 36).
# Canonical copy lives in the repo; symlink it into the user unit dir:
#   ln -sfn ~/.grimoire/deploy/grimoire.service ~/.config/systemd/user/grimoire.service
#   systemctl --user daemon-reload && systemctl --user enable --now grimoire
# Replaces the old system unit /etc/systemd/system/grimoire.service.
[Unit]
Description=Grimoire Knowledge Graph Server
Documentation=https://github.com/vgvm-lbl/grimoire
After=network.target

[Service]
WorkingDirectory=%h/.grimoire
EnvironmentFile=%h/.grimoire/.env
ExecStart=%h/.grimoire/bin/node bin/grim-server.js
Restart=on-failure
RestartSec=10
StandardOutput=append:%h/data/logs/grimoire/grim-server.log
StandardError=append:%h/data/logs/grimoire/grim-server.log
SyslogIdentifier=grimoire

[Install]
WantedBy=default.target
